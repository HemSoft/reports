{
  "name": "@hemsoft/reports",
  "version": "1.0.0",
  "description": "Productivity audit engine and 3D reporting dashboard for HemSoft repositories",
  "main": "cli.py",
  "scripts": {
    "report": "python cli.py --weeks 12 --output D:\\hemsoft-productivity.html",
    "report:refresh": "python cli.py --weeks 12 --refresh --output D:\\hemsoft-productivity.html",
    "test": "python scripts/run_tests.py",
    "lint:python": "python -m ruff check . && python -m ruff format --check .",
    "lint:markdown": "markdownlint \"**/*.md\"",
    "fixture": "python scripts/generate_fixture.py",
    "test:browser": "npm run fixture && playwright test",
    "benchmark": "python scripts/generate_benchmark.py && node scripts/benchmark_browser.js",
    "test:budget": "node --test tests/performance/budget.test.js",
    "benchmark:probe": "python scripts/generate_benchmark.py && node scripts/verify_budget_probe.js"
  },
  "keywords": [
    "productivity",
    "audit",
    "github",
    "metrics",
    "threejs",
    "visualization"
  ],
  "author": "Franz Hemmer <franz_hemmer@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "chart.js": "4.5.1",
    "markdownlint-cli": "0.49.1",
    "three": "0.128.0"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "markdown-it": "14.3.1",
    "smol-toml": "1.9.0",
    "katex": "0.19.0"
  }
}
